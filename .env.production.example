# Production Environment Variables Template
# Copy this file and fill in your actual values

# Application
FRONTEND_URL=https://yourfrontend.com

# Public domain the brand runs on. Drives the email From address, the asset
# and menu links inside emails, the password reset link fallback and CORS.
# Bare hostname — no scheme, no trailing slash.
SITE_DOMAIN=goldsushi.store
NODE_ENV=production
PORT=4200

# Where the password reset email sends the user.
# Defaults to ${FRONTEND_URL}/reset-password — the token is appended as ?token=
PASSWORD_RESET_URL=https://yourfrontend.com/reset-password

# Email (Resend). Without RESEND_API_KEY every outgoing email is skipped —
# registration, order confirmation and password reset all go silently undelivered.
# Emails are sent from noreply@<SITE_DOMAIN>, so that domain MUST be verified
# in Resend (Domains -> Add Domain) or the API rejects them.
RESEND_API_KEY=re_your-resend-api-key
MAIL_BRAND_NAME=Gold Sushi

# JWT Configuration
# NOTE: the code reads JWT_SECRET and JWT_EXPIRES_IN; JWT_ACCESS/JWT_REFRESH are not used yet.
JWT_SECRET=your-super-secret-jwt-signing-key-change-this
JWT_EXPIRES_IN=30d
JWT_ACCESS=your-super-secret-jwt-access-key-change-this
JWT_REFRESH=your-super-secret-jwt-refresh-key-change-this
JWT_ACCESS_MAX_AGE=3600
JWT_REFRESH_MAX_AGE=604800

# Database Configuration (Digital Ocean Managed Database recommended)
DB_HOST=your-db-host.db.ondigitalocean.com
DB_PORT=25060
DB_PASSWORD=your-secure-database-password
DB_USERNAME=doadmin
DB_DATABASE=goldsushi

# Docker Registry (for GitHub Container Registry)
DOCKER_REGISTRY=ghcr.io/yourusername
IMAGE_TAG=latest

# Google Cloud Configuration (if using)
GC_KEYPATH=/path/to/service-account-key.json
GC_PROJECT=your-google-cloud-project-id
GC_BUCKET=your-storage-bucket-name

# Payment System (LiqPay)
LIQPAY_PUBLIC=your-liqpay-public-key
LIQPAY_PRIVATE=your-liqpay-private-key

# Payment System (Monobank online acquiring)
MONOBANK_TOKEN=your-monobank-merchant-token
MONOBANK_API_URL=https://api.monobank.ua
MONOBANK_INVOICE_VALIDITY=3600
PUBLIC_API_URL=https://yourapi.com
MONOBANK_WEBHOOK_URL=https://yourapi.com/api/payments/monobank/webhook
PAYMENT_REDIRECT_URL=https://yourfrontend.com/checkout/result
MONOPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
MONOPAY_KEY_ID=

# Digital Ocean Deployment (for CI/CD)
DROPLET_IP=your.droplet.ip.address
SSH_USER=root

